# Level 3 Provide is handled by another Janet vat on the same vat object.
(import capnp)

(def alice (capnp/rpc-connect))
(def bob (capnp/rpc-connect))
(def carol (capnp/rpc-connect))
(capnp/rpc-share-vat bob carol)

(defn ignore [iface method params results]
  nil)

(capnp/rpc-serve bob ignore)
(def boot (capnp/rpc-bootstrap alice))
(each frame (capnp/rpc-flush alice)
  (capnp/rpc-handle bob frame))
(each frame (capnp/rpc-flush bob)
  (capnp/rpc-handle alice frame))
(assert (capnp/rpc-answered? alice boot) "bootstrap")
(def cap-id (capnp/rpc-answer-cap alice boot))
(def nonce (int/u64 "99"))
(def pq (capnp/rpc-provide alice cap-id "carol.example" 9 nonce))
(each frame (capnp/rpc-flush alice)
  (capnp/rpc-handle bob frame))
(def held (capnp/rpc-provisions bob))
(assert (= (length held) 1) "one provision")
(assert (= (held 0) nonce) "nonce")
(def aq (capnp/rpc-send-accept carol nonce false))
(each frame (capnp/rpc-flush carol)
  (capnp/rpc-handle bob frame))
(each frame (capnp/rpc-flush bob)
  (capnp/rpc-handle carol frame))
(assert (capnp/rpc-answered? carol aq) "accept answered")
(assert (not (capnp/rpc-failed? carol aq)) "accept ok")
(capnp/rpc-disembargo alice pq)
(print "ok janet level3")
